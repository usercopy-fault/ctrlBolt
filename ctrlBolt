#!/usr/bin/env python3
"""
ctrlBolt: numbered-prompt chain runner for AI coding CLIs.

Purpose:
  Run prompt kits like:
    00_MASTER_ARCHITECTURE.md
    01_CORE.md
    02_REFINER.md

  through different AI coding providers with:
    - per-project state
    - resume
    - logs
    - usage/quota clean exit
    - git checkpoints
    - optional tests
    - provider adapters

Examples:
  ctrlBolt --provider codex \
    --prompt-dir ~/bb/projects/macsvg_prompt_kit \
    --root-dir ~/bb/projects \
    --project-dir ~/bb/projects/macsvg \
    --danger

  ctrlBolt --resume --project-dir ~/bb/projects/macsvg

  ctrlBolt providers

  ctrlBolt --provider claude \
    --prompt-dir ~/bb/projects/macsvg_prompt_kit \
    --root-dir ~/bb/projects \
    --project-dir ~/bb/projects/macsvg \
    --danger

  ctrlBolt --provider custom \
    --provider-cmd 'myagent --project {project_dir} --prompt-file {prompt_file}' \
    --prompt-dir ~/prompts/toolkit \
    --root-dir ~/bb/projects \
    --project-dir ~/bb/projects/tool
"""

from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional, Tuple


USAGE_PATTERNS = [
    r"usage limit",
    r"limit reached",
    r"rate limit",
    r"quota",
    r"insufficient_quota",
    r"out of.*usage",
    r"too many requests",
    r"billing",
    r"weekly limit",
    r"5[- ]?hour",
    r"daily limit",
    r"monthly limit",
    r"credit balance",
    r"exceeded your current quota",
    r"usage credits",
    r"maximum.*budget",
    r"max.*turns.*reached",
]

DEFAULT_PROMPT_GLOBS = [
    r"^[0-9][0-9][_-].*\.md$",
    r"^[0-9][0-9][_-].*\.txt$",
    r"^[0-9][0-9][_-].*\.prompt$",
]


@dataclass
class ProviderSpec:
    name: str
    description: str
    mode: str  # stdin | arg | custom | ollama
    base_cmd: List[str]
    danger_args: List[str]
    prompt_arg_flag: Optional[str] = None
    stdin_marker: Optional[str] = None
    supports_edits: bool = True
    notes: str = ""


PROVIDERS: Dict[str, ProviderSpec] = {
    "codex": ProviderSpec(
        name="codex",
        description="OpenAI Codex CLI, non-interactive exec mode.",
        mode="stdin",
        base_cmd=["codex", "exec"],
        danger_args=["--dangerously-bypass-approvals-and-sandbox"],
        stdin_marker="-",
        supports_edits=True,
        notes="Uses: codex exec [flags] -",
    ),
    "claude": ProviderSpec(
        name="claude",
        description="Claude Code print mode.",
        mode="arg",
        base_cmd=["claude", "-p"],
        danger_args=["--permission-mode", "bypassPermissions"],
        supports_edits=True,
        notes="Uses: claude -p [flags] '<prompt>'. For very large prompts, use --provider custom.",
    ),
    "gemini": ProviderSpec(
        name="gemini",
        description="Gemini CLI headless/non-interactive prompt mode.",
        mode="arg",
        base_cmd=["gemini", "-p"],
        danger_args=["--approval-mode", "auto_edit"],
        supports_edits=True,
        notes="Uses: gemini -p '<prompt>'. Adjust danger args if your Gemini CLI version differs.",
    ),
    "aider": ProviderSpec(
        name="aider",
        description="Aider scripted mode.",
        mode="arg",
        base_cmd=["aider", "--yes-always", "--no-auto-commits", "--message"],
        danger_args=[],
        supports_edits=True,
        notes="Uses: aider --yes-always --no-auto-commits --message '<prompt>'.",
    ),
    "opencode": ProviderSpec(
